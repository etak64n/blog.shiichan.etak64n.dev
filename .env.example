# The account and the local secret of the blog. Copy this file to .env and fill in
# the values there. Git ignores .env but keeps this file, so never write values here.

# CLOUDFLARE_ACCOUNT_ID
#   The Cloudflare account of the blog. `cf deploy` and the D1 scripts in
#   package.json run against it. `cf accounts list` shows the IDs.
CLOUDFLARE_ACCOUNT_ID=

# DEV_BEARER_TOKEN
#   Any random string. Under `cf dev`, the ingest API accepts it as a bearer token
#   in place of a GitHub Actions OIDC token. Production has no such token.
DEV_BEARER_TOKEN=
